{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["lib/**/*.js", "types/**/*.d.ts", "scripts/**/*.mjs", "test/**/*.js"],
  "exclude": ["node_modules"]
}
